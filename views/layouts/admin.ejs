<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'WhatsApp Bot Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    :root {
      --primary-color: #25D366;
      --secondary-color: #128C7E;
      --dark-color: #075E54;
      --light-color: #DCF8C6;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f5f5;
    }
    
    .sidebar {
      background-color: #fff;
      min-height: 100vh;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      position: fixed;
      width: 250px;
    }
    
    .sidebar-header {
      padding: 20px;
      background-color: var(--primary-color);
      color: white;
    }
    
    .sidebar-menu {
      padding: 0;
      list-style: none;
    }
    
    .sidebar-menu li {
      border-bottom: 1px solid #eee;
    }
    
    .sidebar-menu li a {
      display: block;
      padding: 15px 20px;
      color: #333;
      text-decoration: none;
      transition: all 0.3s;
    }
    
    .sidebar-menu li a:hover,
    .sidebar-menu li a.active {
      background-color: var(--light-color);
      color: var(--dark-color);
      padding-left: 25px;
    }
    
    .sidebar-menu li a i {
      margin-right: 10px;
      width: 20px;
      text-align: center;
    }
    
    .main-content {
      margin-left: 250px;
      padding: 20px;
    }
    
    .navbar {
      background-color: white;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      padding: 10px 20px;
      margin-bottom: 20px;
    }
    
    .navbar-brand {
      font-weight: bold;
      color: var(--dark-color);
    }
    
    .card {
      border: none;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      margin-bottom: 20px;
    }
    
    .card-header {
      background-color: white;
      border-bottom: 1px solid #eee;
      font-weight: bold;
      padding: 15px 20px;
    }
    
    .btn-primary {
      background-color: var(--primary-color);
      border-color: var(--primary-color);
    }
    
    .btn-primary:hover,
    .btn-primary:focus {
      background-color: var(--secondary-color);
      border-color: var(--secondary-color);
    }
    
    .alert {
      border-radius: 10px;
    }
    
    /* Mobile responsive */
    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        position: relative;
        min-height: auto;
      }
      
      .main-content {
        margin-left: 0;
      }
      
      .sidebar-toggle {
        display: block;
      }
    }
  </style>
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-header">
        <h3><i class="fab fa-whatsapp"></i> WhatsApp Bot</h3>
      </div>
      <ul class="sidebar-menu">
        <li>
          <a href="/admin/dashboard" class="<%= typeof path !== 'undefined' && path === '/admin/dashboard' ? 'active' : '' %>">            
            <i class="fas fa-tachometer-alt"></i> Dashboard
          </a>
        </li>
        <li>
          <a href="/admin/whatsapp" class="<%= typeof path !== 'undefined' && path === '/admin/whatsapp' ? 'active' : '' %>">            
            <i class="fab fa-whatsapp"></i> WhatsApp Connection
          </a>
        </li>
        <li>
          <a href="/whatsapp/send" class="<%= typeof path !== 'undefined' && path === '/whatsapp/send' ? 'active' : '' %>">            
            <i class="fas fa-paper-plane"></i> Send Message
          </a>
        </li>
        <li>
          <a href="/whatsapp/chats" class="<%= typeof path !== 'undefined' && path === '/whatsapp/chats' ? 'active' : '' %>">            
            <i class="fas fa-comments"></i> Chats
          </a>
        </li>
        <li>
          <a href="/admin/scheduled" class="<%= typeof path !== 'undefined' && path === '/admin/scheduled' ? 'active' : '' %>">            
            <i class="fas fa-clock"></i> Scheduled Messages
          </a>
        </li>
        <li>
          <a href="/admin/settings" class="<%= typeof path !== 'undefined' && path === '/admin/settings' ? 'active' : '' %>">            
            <i class="fas fa-cog"></i> Settings
          </a>
        </li>
        <li>
          <a href="/logout">
            <i class="fas fa-sign-out-alt"></i> Logout
          </a>
        </li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      <nav class="navbar">
        <div class="container-fluid">
          <span class="navbar-brand mb-0 h1"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></span>
        </div>
      </nav>

      <% if (locals.error && error.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
      <% } %>
      
      <% if (locals.success && success.length > 0) { %>
        <div class="alert alert-success" role="alert">
          <%= success %>
        </div>
      <% } %>

      <%- body %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>